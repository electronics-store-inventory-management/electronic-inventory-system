APP_ENV=development
# DATABASE_URL takes priority. Production requires the certificate's hostname and a trusted CA.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
DATABASE_SSL_ROOT_CERT=
DATABASE_USER=postgres
DATABASE_PASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=electronics_store_db
# Generate a local random value before using login.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
# Defaults to enabled in development and disabled in production. Enable only for an isolated demo in production.
# REGISTRATION_ENABLED=false
# Keep blank unless the ingress IPs and forwarded header behavior have been verified.
AUTH_TRUSTED_PROXY_NETWORKS=
LOGIN_REQUESTS_PER_MINUTE=12
REGISTRATION_REQUESTS_PER_MINUTE=5
